{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/docker/backup.Dockerfile",
    "watchPatterns": ["packages/db/**", "deploy/docker/backup.Dockerfile", "deploy/bundle.mjs"]
  },
  "deploy": {
    "cronSchedule": "17 3 * * *",
    "restartPolicyType": "NEVER"
  }
}
