# Rendered by the nginx image's entrypoint (envsubst of ${PORT} and ${API_UPSTREAM}).
server {
  listen ${PORT};
  listen [::]:${PORT};
  root /usr/share/nginx/html;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # The API, on the same origin as the app (session cookie, CSRF Origin check).
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    # An https upstream (e.g. the API's public domain) needs SNI.
    proxy_ssl_server_name on;
    # Server-Sent Events: stream, and keep long-lived connections open.
    proxy_buffering off;
    proxy_read_timeout 1h;
    # Contract uploads are capped at 20 MB by the API.
    client_max_body_size 21m;
  }

  # Hashed build output: cache forever.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Everything else is the SPA: files if they exist, else index.html. Never cached,
  # so a deploy is picked up on the next load.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
