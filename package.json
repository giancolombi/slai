{
  "name": "slai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d postgres mailpit",
    "db:migrate": "pnpm --filter @slai/db migrate",
    "db:seed": "pnpm --filter @slai/db seed",
    "setup:env": "tsx packages/db/src/scripts/setup-env.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
