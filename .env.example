# Copy to .env. `pnpm setup:env` generates the secrets for you.
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:8787

# Postgres. Migrations run as the owner; the app connects as the RLS-restricted role.
DATABASE_URL=postgres://slai:slai@localhost:5433/slai
DATABASE_APP_URL=postgres://slai_app:slai_app@localhost:5433/slai
# systemDb (slai_worker role): webhook routing, cross-org timer sweeps only.
DATABASE_SYSTEM_URL=postgres://slai_worker:slai_worker@localhost:5433/slai
# authDb (slai_auth role): better-auth's identity tables only (passwords, sessions, 2FA, passkeys, SSO).
DATABASE_AUTH_URL=postgres://slai_auth:slai_auth@localhost:5433/slai

# 32-byte base64 key for encrypting connector credentials and MFA secrets.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# 32-byte base64 secret for better-auth: signs session cookies, seals TOTP secrets and backup codes.
SESSION_SECRET=
# Rotation: bump SESSION_SECRET_VERSION and keep old secrets readable as version:secret[,...].
# SESSION_SECRET_VERSION=1
# SESSION_SECRETS_PREVIOUS=
# Origins of internal (private-network) IdPs that SSO may call, comma-separated. Public IdPs need none.
# SSO_TRUSTED_IDP_ORIGINS=

# Object storage for uploaded contracts. "local" writes to ./.data/uploads.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads

# Email (Mailpit locally).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="slai <alerts@slai.local>"

# AI. MODEL_PROVIDER=mock runs everything with deterministic fixtures and no keys.
MODEL_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agent runtime: "local" (in-process) or "e2b".
AGENT_RUNTIME=local
E2B_API_KEY=
# Must be pinned to an immutable build: slai-agent:<buildId> (printed by `pnpm --filter @slai/agents build:template`).
E2B_TEMPLATE=

# Worker (defaults shown). The sweep and sync scheduling use DATABASE_SYSTEM_URL.
# WORKER_CONCURRENCY=5
# SWEEP_INTERVAL_SECONDS=15
# SYNC_INTERVAL_DEMO_SECONDS=60
# SYNC_INTERVAL_SECONDS=300
# SYNC_BACKFILL_DAYS=14

# Billing (T-65). Leave unset for manual mode: plans come from the seed or POST /billing/manual.
# Stripe test mode: sk_test_… and the webhook signing secret (`stripe listen` prints one locally).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring monthly prices for the self-serve plans.
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_SCALE=price_...
# Metered prices attached to the Billing Meters below (overage, billed in arrears).
# STRIPE_PRICE_TICKET_OVERAGE=price_...
# STRIPE_PRICE_CREDIT_OVERAGE=price_...
# STRIPE_METER_TRACKED_TICKETS=slai_tracked_ticket_overage
# STRIPE_METER_CREDITS=slai_credit_overage
# BILLING_INTERVAL_SECONDS=3600

# OAuth apps for "Continue with <Provider>" (optional; the button is disabled until both are set).
# Register the redirect URI ${API_URL}/api/v1/connections/oauth/<provider>/callback with each provider.
# OAUTH_ZENDESK_CLIENT_ID=
# OAUTH_ZENDESK_CLIENT_SECRET=
# OAUTH_INTERCOM_CLIENT_ID=
# OAUTH_INTERCOM_CLIENT_SECRET=
# OAUTH_HUBSPOT_CLIENT_ID=
# OAUTH_HUBSPOT_CLIENT_SECRET=
# OAUTH_SALESFORCE_CLIENT_ID=
# OAUTH_SALESFORCE_CLIENT_SECRET=
# OAUTH_ZOHO_DESK_CLIENT_ID=
# OAUTH_ZOHO_DESK_CLIENT_SECRET=
# OAUTH_HELP_SCOUT_CLIENT_ID=
# OAUTH_HELP_SCOUT_CLIENT_SECRET=
