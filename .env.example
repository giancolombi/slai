# Copy to .env. `pnpm setup:env` generates the secrets for you.
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:8787

# Postgres. Migrations run as the owner; the app connects as the RLS-restricted role.
DATABASE_URL=postgres://slai:slai@localhost:5433/slai
DATABASE_APP_URL=postgres://slai_app:slai_app@localhost:5433/slai

# 32-byte base64 key for encrypting connector credentials and MFA secrets.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# 32-byte base64 key for signing session tokens and webhook URLs.
SESSION_SECRET=

# Object storage for uploaded contracts. "local" writes to ./.data/uploads.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads

# Email (Mailpit locally).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="slai <alerts@slai.local>"

# AI. MODEL_PROVIDER=mock runs everything with deterministic fixtures and no keys.
MODEL_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agent runtime: "local" (in-process) or "e2b".
AGENT_RUNTIME=local
E2B_API_KEY=
E2B_TEMPLATE=slai-agent
