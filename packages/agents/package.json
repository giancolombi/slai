{
  "name": "@slai/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build:sandbox": "esbuild ../../sandbox/runner.ts --bundle --platform=node --format=esm --target=node24 --outfile=../../sandbox/dist/runner.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "sandbox:template": "tsx scripts/build-template.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@slai/sla-engine": "workspace:*",
    "e2b": "^2.51.0",
    "mammoth": "^1.13.0",
    "openai": "^7.23.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
